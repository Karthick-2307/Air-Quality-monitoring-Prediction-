# Air Quality Dashboard Environment Variables
# Copy this file to .env and fill in your values

# Flask
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change_this_to_a_random_secret_key

# AI API Key (optional - for AI Assistant feature)
# Get a free Gemini key at https://aistudio.google.com
# Or use any other AI provider's key
AI_API_KEY=your_ai_api_key_here
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent

# OpenAQ API Key (optional - secondary data source)
# Register at https://explore.openaq.org/register
OPENAQ_API_KEY=your_openaq_api_key_here